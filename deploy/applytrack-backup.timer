# Планирует ночную резервную копию на 03:07.
#
# Необычная минута выбрана намеренно: когда все таймеры на машине срабатывают
# ровно в :00, небольшой VPS получает всплеск нагрузки, которого никто не
# планировал.

[Unit]
Description=Запускать резервное копирование базы ApplyTrack каждую ночь

[Timer]
OnCalendar=*-*-* 03:07:00
Persistent=true
RandomizedDelaySec=180

[Install]
WantedBy=timers.target
