# Боевой конфигурация API.
#
# Скопируйте на сервере в `deploy/env.production` и заполните:
#
#   cp env.production.example env.production
#   chmod 600 env.production
#
# Настоящий файл нельзя коммитить — он перечислен в .gitignore.

# --- База данных ---
POSTGRES_USER=applytrack
POSTGRES_PASSWORD=change-me
POSTGRES_DB=applytrack

# --- Аутентификация ---
# Ключ генерируется так:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-insecure-secret-key-change-me

# Сколько живёт токен доступа.
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Окружение ---
ENVIRONMENT=production

# --- Логирование ---
LOG_LEVEL=INFO
# В бою по умолчанию стоит "json"; задавайте значение, только если нужно его
# изменить.
LOG_FORMAT=json

# --- CORS (через запятую) ---
# Домены, которым разрешено обращаться к API из браузера. Собственная страница
# документации API живёт на том же origin, поэтому в список её добавлять не
# нужно.
CORS_ORIGINS=https://your-domain.com

# --- Образ ---
# Образ, в котором запускается контейнер API. Рабочий процесс выкладывает по
# одному тегу на каждый релиз; подробнее в docs/DEPLOYMENT.md.
API_IMAGE=ghcr.io/MeldanLess/rest-api:v1.0.0
